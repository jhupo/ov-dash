# Application
APP_NAME=ov-dash
APP_ENV=production
APP_VERSION=latest
APP_SHUTDOWN_TIMEOUT=15s
TZ=Asia/Shanghai
# Use http:// or https:// only. For SOCKS5, leave these empty and set ALL_PROXY.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,redis,api,worker,frontend

# Backend runtime
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_ALLOWED_ORIGINS=http://localhost,http://192.168.2.17
PYTHON_BIN=python3
PYTHON_SCRIPTS_DIR=/app/scripts

# Backend build
GO_VERSION=1.23
GO_IMAGE=docker.1ms.run/library/golang:1.23-alpine
RUNTIME_IMAGE=docker.m.daocloud.io/library/alpine:3.20
BACKEND_IMAGE=ghcr.io/jhupo/ov-dash-backend:latest
APK_REPOSITORY=https://mirrors.aliyun.com/alpine
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
UPDATE_BACKEND_IMAGE_REPOSITORY=ghcr.io/jhupo/ov-dash-backend
UPDATE_FRONTEND_IMAGE_REPOSITORY=ghcr.io/jhupo/ov-dash-frontend
UPDATE_FALLBACK_BUILD=false

# PostgreSQL
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
POSTGRES_DB=ov_dash
POSTGRES_USER=ov_dash
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DSN=postgres://ov_dash:change_me_strong_postgres_password@localhost:5432/ov_dash?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2

# Redis
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=change_me_strong_redis_password
REDIS_DB=0
REDIS_PREFIX=ov-dash
REDIS_BIND=127.0.0.1
REDIS_PORT=6379

# Worker
WORKER_QUEUE_NAME=jobs:default
WORKER_POLL_INTERVAL=1s
WORKER_JOB_TIMEOUT=5m
WORKER_CONCURRENCY=4
WORKER_VISIBILITY_LEASE=10m

# Frontend
NODE_VERSION=22
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
NGINX_IMAGE=docker.1ms.run/library/nginx:1.27-alpine
FRONTEND_IMAGE=ghcr.io/jhupo/ov-dash-frontend:latest
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
FRONTEND_PORT=80
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_DEVTOOLS=false
