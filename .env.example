# Application
APP_NAME=ov-dash
APP_ENV=production
APP_VERSION=0.1.0
APP_SHUTDOWN_TIMEOUT=15s
APP_SECRET_ACTIVE_KEY_ID=primary
APP_SECRET_KEYS_JSON={"primary":"replace_with_a_strong_random_secret"}
TZ=Asia/Shanghai
# Use http:// or https:// only. For SOCKS5, leave these empty and set ALL_PROXY.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,redis,app

# Backend runtime
HTTP_HOST=0.0.0.0
APP_BIND=0.0.0.0
APP_PORT=50003
HTTP_PORT=8080
HTTP_ALLOWED_ORIGINS=http://localhost,http://192.168.2.17
HTTP_TRUSTED_PROXY_CIDRS=172.16.0.0/12
COOKIE_SECURE=false

# Signed application package updates
UPDATE_RUNTIME_DIR=/opt/ov-dash/runtime
UPDATE_RELEASE_REPOSITORY=jhupo/ov-dash
# Optional HTTPS download accelerator prefix, for example https://ghfast.top
UPDATE_PROXY_URL=
# PKIX PEM or base64 Ed25519 public key. Required only for online updates.
UPDATE_PUBLIC_KEY=
UPDATE_EXIT_DELAY=2s

# Backend build
GO_VERSION=1.23
GO_IMAGE=golang:1.23-alpine
RUNTIME_IMAGE=alpine:3.20
APP_IMAGE=ghcr.io/jhupo/ov-dash-runtime:latest
APK_REPOSITORY=https://mirrors.aliyun.com/alpine
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn

# PostgreSQL
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
POSTGRES_DB=ov_dash
POSTGRES_USER=ov_dash
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DSN=postgres://ov_dash:change_me_strong_postgres_password@localhost:5432/ov_dash?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2

# Redis
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=change_me_strong_redis_password
REDIS_DB=0
REDIS_PREFIX=ov-dash
REDIS_BIND=127.0.0.1
REDIS_PORT=6379

# Worker
WORKER_QUEUE_NAME=jobs-default
WORKER_JOB_TIMEOUT=5m
WORKER_CONCURRENCY=4
WORKER_RESCUE_AFTER=15m

# Frontend build
NODE_VERSION=22
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_DEVTOOLS=false
