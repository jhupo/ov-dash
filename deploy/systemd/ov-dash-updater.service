[Unit]
Description=ov-dash privileged release updater
Documentation=https://github.com/jhupo/ov-dash
Requires=docker.service
After=docker.service network-online.target
Before=ov-dash-compose.service
Wants=network-online.target
PartOf=docker.service
ConditionFileIsExecutable=/usr/local/libexec/ov-dash-updater
ConditionPathExists=/etc/ov-dash/release.pub
ConditionPathExists=/var/lib/ov-dash/updater/deployment.json

[Service]
Type=notify
NotifyAccess=main
User=root
Group=ov-dash
Environment=DOCKER_CONFIG=/tmp/ov-dash-docker
EnvironmentFile=/etc/ov-dash/updater.env
WorkingDirectory=/opt/ov-dash
RuntimeDirectory=ov-dash
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/usr/local/libexec/ov-dash-updater \
  --state-dir=/var/lib/ov-dash/updater \
  --socket=${OV_DASH_SOCKET_PATH} \
  --release-url=${OV_DASH_RELEASE_URL} \
  --release-public-key=/etc/ov-dash/release.pub \
  --work-dir=/opt/ov-dash \
  --compose-file=/opt/ov-dash/docker-compose.yml \
  --base-env-file=/opt/ov-dash/.env \
  --release-env-file=/var/lib/ov-dash/updater/current.env \
  --project=ov-dash \
  --docker-binary=/usr/bin/docker \
  --artifacts=backend=BACKEND_IMAGE,frontend=FRONTEND_IMAGE \
  --services=api=backend,worker=backend,frontend=frontend,migrate=backend \
  --application-services=api,worker,frontend \
  --validation-services=api \
  --resume-services=worker,frontend \
  --migration-service=migrate \
  --database-service=postgres \
  --database-name=${OV_DASH_DATABASE_NAME} \
  --database-user=${OV_DASH_DATABASE_USER} \
  --validation-health-url=http://127.0.0.1:${OV_DASH_HEALTH_PORT}/readyz?scope=api \
  --health-url=http://127.0.0.1:${OV_DASH_HEALTH_PORT}/readyz
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
TimeoutStartSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/ov-dash/updater /run/ov-dash /run/docker.sock

[Install]
WantedBy=multi-user.target
